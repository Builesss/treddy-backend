generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model auditoria {
  auditoria_id       BigInt   @id @default(autoincrement())
  usuario_id         BigInt
  tabla_afectada     String   @db.VarChar(100)
  registro_id        BigInt
  accion             String   @db.VarChar(20)
  datos_antes        Json?    @db.Json
  datos_despues      Json?    @db.Json
  descripcion_cambio String?
  fecha              DateTime @default(now()) @db.Timestamp(6)
  usuarios           usuarios @relation(fields: [usuario_id], references: [usuario_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_auditoria_usuarios")
}

model detallepedido {
  detalle_id         BigInt             @id @default(autoincrement())
  pedido_id          BigInt
  producto_id        BigInt
  personalizacion_id BigInt?
  cantidad           Int
  subtotal           Decimal            @db.Decimal(10, 2)
  created_at         DateTime           @default(now()) @db.Timestamp(6)
  updated_at         DateTime           @default(now()) @db.Timestamp(6)
  pedidos            pedidos            @relation(fields: [pedido_id], references: [pedido_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_detallepedido_pedidos")
  personalizaciones  personalizaciones? @relation(fields: [personalizacion_id], references: [personalizacion_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_detallepedido_personalizaciones")
  productos          productos          @relation(fields: [producto_id], references: [producto_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_detallepedido_productos")

  @@index([pedido_id, producto_id], map: "idx_detallepedido_pedido_producto")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model envios {
  envio_id        BigInt   @id @default(autoincrement())
  pedido_id       BigInt
  domiciliario_id BigInt
  direccion_envio String
  fecha_envio     DateTime @db.Timestamp(6)
  fecha_entrega   DateTime @default(now()) @db.Timestamp(6)
  estado_envio    String?  @default("pendiente") @db.VarChar(20)
  created_at      DateTime @default(now()) @db.Timestamp(6)
  updated_at      DateTime @default(now()) @db.Timestamp(6)
  usuarios        usuarios @relation(fields: [domiciliario_id], references: [usuario_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_envios_domiciliarios")
  pedidos         pedidos  @relation(fields: [pedido_id], references: [pedido_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_envios_pedidos")

  @@index([pedido_id, domiciliario_id], map: "idx_envios_pedido_domiciliario")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model historialpedidos {
  historial_id BigInt    @id @default(autoincrement())
  pedido_id    BigInt
  estado       String?   @db.VarChar(30)
  medio_pago   String?   @db.VarChar(30)
  total        Decimal?  @db.Decimal(10, 2)
  fecha        DateTime  @default(now()) @db.Timestamp(6)
  accion       String?   @db.VarChar(20)
  usuario_id   BigInt?
  pedidos      pedidos   @relation(fields: [pedido_id], references: [pedido_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_historialpedidos_pedidos")
  usuarios     usuarios? @relation(fields: [usuario_id], references: [usuario_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_historialpedidos_usuarios")

  @@index([pedido_id, fecha], map: "idx_historialpedidos_pedido_fecha")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model historialproductos {
  historial_id BigInt    @id @default(autoincrement())
  producto_id  BigInt
  nombre       String?   @db.VarChar(150)
  descripcion  String?
  precio_base  Decimal?  @db.Decimal(10, 2)
  stock        Int?
  estado       String?   @db.VarChar(20)
  fecha        DateTime  @default(now()) @db.Timestamp(6)
  accion       String?   @db.VarChar(20)
  usuario_id   BigInt?
  categoria    String?   @db.VarChar(100)
  productos    productos @relation(fields: [producto_id], references: [producto_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_historialproductos_productos")
  usuarios     usuarios? @relation(fields: [usuario_id], references: [usuario_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_historialproductos_usuarios")

  @@index([producto_id, fecha], map: "idx_historialproductos_producto_fecha")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model pedidos {
  pedido_id        BigInt             @id @default(autoincrement())
  usuario_id       BigInt
  fecha_pedido     DateTime           @default(now()) @db.Timestamp(6)
  estado           String?            @default("pendiente") @db.VarChar(30)
  medio_pago       String             @db.VarChar(20)
  total            Decimal            @db.Decimal(10, 2)
  created_at       DateTime           @default(now()) @db.Timestamp(6)
  updated_at       DateTime           @default(now()) @db.Timestamp(6)
  codigo_pedido    String?            @unique @db.VarChar(50)
  costo_envio      Decimal?           @db.Decimal(10, 2)
  direccion_id     BigInt?
  impuestos        Decimal?           @db.Decimal(10, 2)
  pago_aprobado    Boolean            @default(false)
  subtotal         Decimal?           @db.Decimal(10, 2)
  detallepedido    detallepedido[]
  envios           envios[]
  historialpedidos historialpedidos[]
  direcciones      direcciones?       @relation(fields: [direccion_id], references: [id], map: "fk_pedidos_direcciones")
  usuarios         usuarios           @relation(fields: [usuario_id], references: [usuario_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_pedidos_usuarios")

  @@index([usuario_id, estado], map: "idx_pedido_usuario_estado")
}

model direcciones {
  id            BigInt    @id @default(autoincrement())
  usuario_id    BigInt
  alias         String?   @db.VarChar(50)
  calle         String    @db.VarChar(150)
  numero        String    @db.VarChar(50)
  ciudad        String    @db.VarChar(100)
  departamento  String    @db.VarChar(100)
  codigo_postal String    @db.VarChar(20)
  principal     Boolean   @default(false)
  created_at    DateTime  @default(now()) @db.Timestamp(6)
  updated_at    DateTime  @default(now()) @db.Timestamp(6)
  latitud       Decimal?  @db.Decimal(10, 8)
  longitud      Decimal?  @db.Decimal(11, 8)
  usuarios      usuarios  @relation(fields: [usuario_id], references: [usuario_id], onDelete: Cascade, map: "fk_direcciones_usuarios")
  pedidos       pedidos[]
}

model personalizaciones {
  personalizacion_id BigInt          @id @default(autoincrement())
  producto_id        BigInt
  color              String?         @db.VarChar(50)
  tamano             String?         @db.VarChar(50)
  forma              String?         @db.VarChar(50)
  created_at         DateTime        @default(now()) @db.Timestamp(6)
  updated_at         DateTime        @default(now()) @db.Timestamp(6)
  archivo_3d_path    String?
  vista_ar_path      String?
  detallepedido      detallepedido[]
  productos          productos       @relation(fields: [producto_id], references: [producto_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_personalizaciones_productos")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model productos {
  producto_id        BigInt               @id @default(autoincrement())
  nombre             String               @db.VarChar(150)
  descripcion        String?
  precio_base        Decimal              @db.Decimal(10, 2)
  stock              Int
  estado             String?              @default("activo") @db.VarChar(20)
  created_at         DateTime             @default(now()) @db.Timestamp(6)
  updated_at         DateTime             @default(now()) @db.Timestamp(6)
  categoria          String?              @db.VarChar(100)
  imagen_path        String?              @db.VarChar(512)
  modelo_3d_path     String?              @db.VarChar(512)
  vista_ar_path      String?              @db.VarChar(512)
  thumbnail_path     String?              @db.VarChar(512)
  carrito_item       carrito_item[]
  detallepedido      detallepedido[]
  historialproductos historialproductos[]
  personalizaciones  personalizaciones[]
  resenas            resenas[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model usuarios {
  usuario_id              BigInt                   @id @default(autoincrement())
  nombre                  String                   @db.VarChar(100)
  apellido                String                   @db.VarChar(100)
  email                   String                   @unique @db.VarChar(150)
  telefono                String?                  @db.VarChar(20)
  contrasena              String                   @db.VarChar(255)
  tipo_usuario            String                   @db.VarChar(20)
  created_at              DateTime                 @default(now()) @db.Timestamp(6)
  updated_at              DateTime                 @default(now()) @db.Timestamp(6)
  estado                  String                   @default("Pendiente") @db.VarChar(20)
  auditoria               auditoria[]
  direcciones             direcciones[]
  envios                  envios[]
  historialpedidos        historialpedidos[]
  historialproductos      historialproductos[]
  pedidos                 pedidos[]
  resenas                 resenas[]
  preferencias_usuario    preferencias_usuario?
}

model preferencias_usuario {
  id                    BigInt    @id @default(autoincrement())
  usuario_id            BigInt    @unique
  notificaciones_email  Boolean   @default(true)
  notificaciones_sms    Boolean   @default(false)
  tema                  String    @default("oscuro") @db.VarChar(10)
  created_at            DateTime  @default(now()) @db.Timestamp(6)
  updated_at            DateTime  @default(now()) @db.Timestamp(6)
  usuarios              usuarios  @relation(fields: [usuario_id], references: [usuario_id], onDelete: Cascade)
}

model carrito {
  id           BigInt         @id @default(autoincrement())
  user_id      BigInt?        @unique
  session_id   String?        @unique @db.VarChar(255)
  created_at   DateTime?      @default(now()) @db.Timestamp(6)
  updated_at   DateTime?      @default(now()) @db.Timestamp(6)
  carrito_item carrito_item[]
}

model carrito_item {
  id              BigInt    @id @default(autoincrement())
  carrito_id      BigInt
  producto_id     BigInt
  cantidad        Int?      @default(1)
  precio_unitario Decimal   @db.Decimal(10, 2)
  carrito         carrito   @relation(fields: [carrito_id], references: [id], onDelete: Cascade, map: "fk_carritoitem_carrito")
  productos       productos @relation(fields: [producto_id], references: [producto_id], onDelete: NoAction, map: "fk_carritoitem_producto")

  @@unique([carrito_id, producto_id], map: "unique_carrito_producto")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model resenas {
  resena_id   BigInt    @id @default(autoincrement())
  producto_id BigInt
  usuario_id  BigInt
  rating      Int
  comentario  String
  created_at  DateTime  @default(now()) @db.Timestamp(6)
  productos   productos @relation(fields: [producto_id], references: [producto_id], onDelete: Cascade)
  usuarios    usuarios  @relation(fields: [usuario_id], references: [usuario_id], onDelete: Cascade)

  @@index([producto_id], map: "idx_resenas_producto")
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
}
